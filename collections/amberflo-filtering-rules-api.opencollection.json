{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amberflo Billing Customers Filtering Rules API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Filtering Rules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amberflo List Filtering Rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.amberflo.io/meter-event-filtering-rules",
            "params": [
              {
                "name": "meterApiName",
                "value": "api-calls",
                "type": "query",
                "description": "The meter API name to list filtering rules for"
              }
            ]
          },
          "docs": "List existing filtering rules for a meter."
        },
        {
          "info": {
            "name": "Amberflo Create or Update Filtering Rule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.amberflo.io/meter-event-filtering-rules",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update a filtering rule for meter events."
        }
      ]
    }
  ],
  "bundled": true
}